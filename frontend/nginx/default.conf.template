server {
    listen 80;
    server_name _;

    # Authentication endpoints are intentionally throttled at the public edge.
    # The API container is bound to loopback by Compose, so remote clients cannot
    # bypass this limit while local host-side development can still reach port 8000.
    # Invite and account-action previews are covered too; leaving a public
    # token lookup unthrottled would create a token-guessing oracle.
    location ~ ^/api/(?:auth/(?:login|register)|invites/[^/]+(?:/accept)?|account-actions/[^/]+)$ {
        limit_req zone=al_medlit_auth burst=10 nodelay;
        limit_req_status 429;

        proxy_pass ${API_PROXY_TARGET};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${API_PROXY_TARGET};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
