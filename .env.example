# -----------------------------------------------------------------------
# AL-MedLit environment variables
# Copy this file to .env at the repository root before using Docker Compose.
#
# The Makefile and the documented raw Compose commands pass this file
# explicitly via `docker compose --env-file .env ...`.
# The backend does not auto-load it when you run `uvicorn` directly on the
# host; for host-side overrides, export the `AL_MEDLIT_*` variables in your
# shell before starting the backend.
# -----------------------------------------------------------------------

# ── Required Docker Compose secrets (laptop and lab profiles) ───────────
# All secrets must be set to strong, unique values before the stack will start.
# The API rejects known placeholder values ("change-me", "al_medlit", ...) at
# startup, so leave these blank here and fill them in your own .env.
# Generate each with: openssl rand -hex 32
POSTGRES_USER=al_medlit
POSTGRES_PASSWORD=
MINIO_ROOT_USER=al_medlit
MINIO_ROOT_PASSWORD=
AL_MEDLIT_STORAGE_ACCESS_KEY=al-medlit-app
AL_MEDLIT_STORAGE_SECRET_KEY=
AL_MEDLIT_JWT_SECRET=

# Optional one-time admin bootstrap. Leave blank during normal startup; set a
# strong value only when running `python -m scripts.bootstrap_admin`.
# AL_MEDLIT_BOOTSTRAP_ADMIN_USERNAME=admin
# AL_MEDLIT_BOOTSTRAP_ADMIN_PASSWORD=

# ── Optional host/backend overrides ─────────────────────────────────────
# These override defaults for host processes and, where passed through,
# the bundled Compose services.
# AL_MEDLIT_APP_NAME=AL-MedLit
# AL_MEDLIT_DATABASE_URL=postgresql+psycopg2://al_medlit:change-me@localhost:5432/al_medlit
# AL_MEDLIT_ECHO_SQL=false
# Public signup is disabled by default. Set true only for an intentional open
# service. Invite acceptance can still provision an explicitly invited user.
# AL_MEDLIT_ALLOW_SELF_REGISTRATION=false
# New workspace storage allocation (10 GiB). Only instance administrators can
# raise/remove an allocation; existing explicit allocations remain unchanged.
# AL_MEDLIT_DEFAULT_WORKSPACE_ARTIFACT_QUOTA_BYTES=10737418240
# Public-edge throttle for login, registration, and invite acceptance.
# AL_MEDLIT_AUTH_RATE=10r/m
# Behind a TLS reverse proxy, list only its actual source addresses/CIDRs,
# separated by spaces. The proxy must append/overwrite X-Forwarded-For with the
# real client address. Empty means forwarded addresses are untrusted.
# AL_MEDLIT_TRUSTED_PROXY_CIDRS=172.18.0.1/32
# Per-account login backoff, applied by the API itself. AL_MEDLIT_AUTH_RATE
# above counts per source address and so never sees a distributed run against
# one account; this counts failed credentials for both existing and unknown
# names. Correct credentials always work and clear the streak. Set 0 to disable.
# AL_MEDLIT_LOGIN_FAILURE_THRESHOLD=10
# AL_MEDLIT_LOGIN_FAILURE_WINDOW_MINUTES=15
# Browser sessions use HttpOnly cookies. The bundled laptop Compose stack
# overrides this to false because it serves plain HTTP on loopback. Keep it
# true for every shared deployment and terminate TLS at the public edge.
# AL_MEDLIT_AUTH_COOKIE_SECURE=true
# Use "lab" when launching the worker-backed shared deployment directly.
# `make lab-up` sets this automatically.
# AL_MEDLIT_DEPLOYMENT_PROFILE=laptop
# AL_MEDLIT_CELERY_BROKER_URL=memory://
# AL_MEDLIT_CELERY_TASK_ALWAYS_EAGER=true
# Training worker concurrency defaults to one, with prefetch one. CPU profiles
# may raise it; accelerator profiles require one and share attempt-root admission.
# AL_MEDLIT_WORKER_CONCURRENCY=1
# AL_MEDLIT_TRAINING_MAX_RUNTIME_SECONDS=86400
# AL_MEDLIT_TRAINING_MAX_QUEUE_WAIT_SECONDS=604800
# AL_MEDLIT_TRAINING_SUPERVISOR_POLL_SECONDS=5
# AL_MEDLIT_TRAINING_TERMINATION_GRACE_SECONDS=10
# AL_MEDLIT_STORAGE_ENDPOINT=localhost:9000
# AL_MEDLIT_STORAGE_BUCKET=al-medlit
# MinIO transport is TLS-only. Compose configures this automatically; these
# paths are useful when the backend runs directly on the host.
# AL_MEDLIT_STORAGE_SECURE=true
# AL_MEDLIT_STORAGE_CA_CERT_PATH=../infra/certs/minio/CAs/ca.crt
# Use an absolute path only when supplying operator-managed MinIO certificates.
# AL_MEDLIT_MINIO_CERTS_DIR=/absolute/path/to/minio-certs
# The Docker API defaults to 8001 so a host-run development API can keep 8000.
# AL_MEDLIT_BACKEND_HOST_PORT=8001
# The laptop frontend is bound to loopback-only port 80 by default.
# AL_MEDLIT_FRONTEND_HOST_PORT=80
# Host ports for the datastores. All three publish on 127.0.0.1 only; change
# the port number if it collides locally, never the bind address.
# AL_MEDLIT_POSTGRES_HOST_PORT=5432
# AL_MEDLIT_MINIO_HOST_PORT=9000
# AL_MEDLIT_MINIO_CONSOLE_HOST_PORT=9001
# AL_MEDLIT_ERROR_PATTERN_MIN_EXAMPLES=3
# AL_MEDLIT_CONFIDENT_DISAGREEMENT_THRESHOLD=0.85

# Optional immutable image digests used when creating image-bound compute
# profiles. Obtain the exact sha256 digest from the built/deployed worker image;
# do not invent one or use a mutable tag as an attestation.
# AL_MEDLIT_CLASSICAL_CPU_IMAGE_DIGEST=
# AL_MEDLIT_TORCH_CPU_IMAGE_DIGEST=
# AL_MEDLIT_TRANSFORMER_CPU_IMAGE_DIGEST=
# AL_MEDLIT_PEFT_ACCELERATOR_IMAGE_DIGEST=
# AL_MEDLIT_QLORA_CUDA_IMAGE_DIGEST=

# ── Optional lab-profile backend overrides for raw docker compose use ───
# `make lab-up` injects these automatically. Set them here only when you run
# `docker compose --env-file .env -f infra/docker-compose.yml --profile lab ...`
# directly.
# AL_MEDLIT_CELERY_BROKER_URL=redis://redis:6379/0
# AL_MEDLIT_CELERY_TASK_ALWAYS_EAGER=false
